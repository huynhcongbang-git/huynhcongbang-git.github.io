---
interface Props {
  title: string;
}
const { title } = Astro.props;
---
<details class="group border border-gray-200 dark:border-gray-800 rounded-lg p-4 my-4 transition-all">
  <summary class="cursor-pointer font-bold text-lg select-none list-none flex items-center justify-between">
    <span>{title}</span>
    <span class="transition-transform group-open:rotate-180">▼</span>
  </summary>
  <div class="mt-4 pt-4 border-t border-gray-100 dark:border-gray-800">
    <slot />
  </div>
</details>
